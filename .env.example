# Local development: keep credentials in ignored .env.local.
NEXT_PUBLIC_SITE_URL=http://localhost:3200
DATABASE_URI=
PAYLOAD_SECRET=
LUMIERE_OWNER_EMAIL=

# Hosted deployment: configure these through the host's UI/API, with Builds
# AND Functions scopes on Netlify. Do not put real secrets in this example.
# CMS_SERVER_URL=https://your-site.netlify.app
# LUMIERE_DATABASE_MODE=hosted
# LUMIERE_DATABASE_HOST=your-approved.pooler.supabase.com
# MEDIA_STORAGE=s3
# S3_ENDPOINT=https://your-project.storage.supabase.co/storage/v1/s3
# S3_REGION=eu-west-1
# S3_BUCKET=elan-media
# S3_PREFIX=lumiere-index/preview
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# RESEND_API_KEY=
# LUMIERE_SENDER_EMAIL=contact@lumiereindex.com
# LUMIERE_LAUNCH_READY=false
# AWS_LAMBDA_JS_RUNTIME=nodejs24.x

# Schema push is disabled. Apply reviewed migrations through the migration account.
