DATABASE_URI=postgres://postgres:postgres@127.0.0.1:5432/elan
PAYLOAD_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Only for a disposable local development database (never staging/production):
PAYLOAD_DB_PUSH=false

# Optional Supabase client configuration (not a PostgreSQL URI):
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Only this account can access Payload admin and modify content or users.
ELAN_HEAD_ADMIN_EMAIL=jamesadebajo7@gmail.com

# Supabase Storage S3 (server-only; create the bucket and an S3 access-key pair):
S3_ENDPOINT=https://wpqsmcczmdbzvsioydmy.storage.supabase.co/storage/v1/s3
S3_REGION=eu-west-1
S3_BUCKET=elan-media
S3_ACCESS_KEY_ID=
